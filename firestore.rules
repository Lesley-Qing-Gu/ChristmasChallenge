rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{game}/scores/{uid} {
      // anyone can see the board
      allow read: if true;

      // each (anonymous) player can only write their own row, it must look like a real run,
      // updates must beat their best, and at most one save every 10 seconds
      allow create: if isOwner(uid) && validRun();
      allow update: if isOwner(uid) && validRun()
                    && request.resource.data.score > resource.data.score
                    && request.time > resource.data.updatedAt + duration.value(10, 's');
      allow delete: if isOwner(uid);

      function isOwner(id) {
        return request.auth != null && request.auth.uid == id;
      }
      function validRun() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'score', 'gifts', 'meters', 'secs', 'updatedAt'])
          && d.name is string && d.name.matches('^[\\p{L}\\p{N} _.\\-]{2,16}$')
          && d.score is int && d.gifts is int && d.meters is int && d.secs is int
          && d.secs >= 1 && d.secs <= 3600
          && d.meters >= 0 && d.meters <= d.secs * 35 + 10
          && d.gifts >= 0 && d.gifts <= d.secs * 2 + 5
          && d.score == d.meters + d.gifts * 50
          && d.updatedAt == request.time;
      }
    }
  }
}
